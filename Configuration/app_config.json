{
  "application": {
    "name": "Quantum Wallet Recovery Suite",
    "version": "6.66.2",
    "build": "20260114-RELEASE",
    "codename": "OBSIDIAN",
    "description": "Key-recovery tool with advanced engine with multi-chain support",
    "disclaimer": "Adjust the configuration according to your choice for the tool.",
    "license": "MIT (Non-Commercial)",
    "author": "QK Researchers",
    "debug_mode": false
  },

  "engine": {
    "core": "Quantum-Seeded ECDLP Reverser",
    "algorithm_backend": "secp256k1",
    "hashing": {
      "primary": "SHA-256",
      "secondary": "Keccak-512",
      "merkle_verify": true,
      "double_hash": true
    },
    "brute_force": {
      "enabled": true,
      "threads": 64,
      "keyspace_start": "0x0000000000000000",
      "keyspace_end": "0xFFFFFFFFFFFFFFFF",
      "batch_size": 1024,
      "seed_randomization": "per-session"
    },
    "quantum_module": {
      "enabled": true,
      "qubits": 4096,
      "decoherence_compensation": true,
      "shor_override": "auto"
    }
  },

  "network": {
    "node_discovery": "peer-list-auto",
    "min_nodes": 12,
    "max_nodes": 52,
    "connection_timeout_ms": 8000,
    "retry_attempts": 3,
    "proxy": {
      "enabled": true,
      "type": "SOCKS5",
      "rotation": "per-request",
      "chain_length": 3,
      "kill_switch": true
    },
    "blockchain_sync": {
      "mode": "headers-only",
      "parallel_downloads": 16,
      "verify_merkle_roots": true,
      "target_blocks_per_session": "auto"
    }
  },

  "supported_chains": [
    { "ticker": "BTC",  "name": "Bitcoin",   "prefix_match": ["1", "3", "bc1"], "key_format": "WIF-base58",  "key_length": 51 },
    { "ticker": "ETH",  "name": "Ethereum",  "prefix_match": ["0x"],            "key_format": "hex",          "key_length": 64 },
    { "ticker": "TRX",  "name": "Tron",      "prefix_match": ["T"],             "key_format": "hex",          "key_length": 64 },
    { "ticker": "SOL",  "name": "Solana",    "prefix_match": ["default"],      "key_format": "base58",        "key_length": 88 },
    { "ticker": "ZEC",  "name": "ZCash",     "prefix_match": ["t1", "zs"],     "key_format": "hex",          "key_length": 64 },
    { "ticker": "DOGE", "name": "Dogecoin",  "prefix_match": ["D"],             "key_format": "WIF-base58",  "key_length": 51 }
  ],

  "session": {
    "session_key_entropy": "64-bit",
    "log_level": "info",
    "log_retention_days": 7,
    "anonymize_logs": true,
    "processing_delay_ms": {
      "min": 900,
      "max": 1100,
      "per_stage": 5
    }
  },

  "output": {
    "display": {
      "theme": "purple-on-black",
      "ascii_banner": "figlet-standard",
      "progress_bars": true,
      "show_balance": true,
      "show_tx_reference": false,
      "show_match_confidence": false,
      "timestamp_format": "local"
    },
    "export": {
      "enabled": true,
      "format": "json",
      "path": "./output/output_keys.json",
      "auto_save": true
    }
  },

  "security": {
    "anti_debug": true,
    "memory_wipe_on_exit": true,
    "obfuscate_runtime": true,
    "self_destruct": false
  }
}